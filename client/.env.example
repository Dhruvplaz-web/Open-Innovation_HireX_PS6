# SkillBridge Client Environment Variables Template
# Only prefix variables with VITE_ if they are explicitly intended to be client-accessible.
# NEVER place database passwords, private keys, or server secrets here.

# Public Site Configuration
VITE_PUBLIC_SITE_URL=https://skillbridge.edu.in
VITE_CONTACT_EMAIL=support@skillbridge.edu.in
VITE_API_BASE_URL=http://localhost:8000

# Optional Web Analytics Provider (Gated by Cookie Consent)
VITE_ANALYTICS_ID=

# Firebase Client Web SDK Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=skillbridge-6b9dc
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
