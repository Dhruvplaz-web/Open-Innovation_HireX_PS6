# SkillBridge Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# Application & Public Domain
PUBLIC_SITE_URL=https://skillbridge.edu.in
CONTACT_EMAIL=support@skillbridge.edu.in
NODE_ENV=production

# Backend Service Configuration
API_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Database & Security Secrets (Server-Side Only - NEVER expose via VITE_)
DATABASE_URL=sqlite:///./skillbridge.db
JWT_SECRET=your-secure-jwt-secret-replace-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# LinkedIn OAuth 2.0 / OpenID Connect (Sign In with LinkedIn using OpenID Connect)
# Register app at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_FRONTEND_REDIRECT_URI=http://localhost:5173

# Web Analytics (Optional - Requires user consent before activation)
ANALYTICS_ID=

# Firebase Client Configuration (Public Web SDK parameters)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=skillbridge-6b9dc
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
